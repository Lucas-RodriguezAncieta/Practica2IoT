# PlatformIO: compilaciones, índices y artefactos generados
**/.pio/
*.bin
*.elf
*.map
*.hex

# Python: entornos, cachés y cobertura
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/

# Secretos locales: conservar las plantillas *.example.h
**/WiFiSecrets.h
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519

# Editor: se conservan settings.json y extensions.json compartibles
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/
*.code-workspace

# Sistema operativo y temporales
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp

# Logs efímeros; las evidencias académicas sí se conservan
*.log
!tests/evidence/**/*.log

# Override local de BMAD; se conservan _bmad/, _bmad-output/ y .agents/
_bmad/config.user.toml
